{
    "name":                 "splash/symfony-user-bundle",
    "description":          "Splash Bundle for Symfony Users",
    "license":              "MIT",
    "minimum-stability":    "dev",
    "prefer-stable":        true,

    "authors": [
        {
            "name":"Splash Sync",
            "email":"contact@splashsync.com"
        },
        {
            "name": "Bernard Paquier",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],

    "autoload": {
        "psr-4": {
            "Splash\\Connectors\\SymfonyUser\\":            "src/"
        }
    },
    
    "autoload-dev": {
        "psr-4": {
           "Splash\\Connectors\\SymfonyUser\\Tests\\":     "tests/"
        }
    },

    "require": {
        "php":                                          "^8.1",
        "splash/php-bundle":                            "^3.0"
    },
    
    "require-dev": {
        "ext-pdo_sqlite":                               "*",
        "badpixxel/php-sdk":                            "^3.0",

        "splash/validator":                             "^1.0",
        "splash/console":                               "^3.0",

        "symfony/http-kernel":                          "^5.4|^6.4|^7.0",
        "symfony/security-core":                        "^5.4|^6.4|^7.0",
        "symfony/security-bundle":                      "^5.4|^6.4|^7.0",
        "symfony/twig-bundle":                          "^5.4|^6.4|^7.0",
        "symfony/translation":                          "^5.4|^6.4|^7.0",
        "symfony/routing":                              "^5.4|^6.4|^7.0",
        "symfony/form":                                 "^5.4|^6.4|^7.0",
        "symfony/browser-kit":                          "^5.4|^6.4|^7.0",
        "symfony/runtime":                              "^5.4|^6.4|^7.0",
        "symfony/mailer":                               "^5.4|^6.4|^7.0",
        "symfony/flex":                                 "^1.0|^2.0|^7.0",
        "symfony/monolog-bundle":                       "*",
        "symfony/phpunit-bridge":                       "*",

        "doctrine/orm":                                 "^2.6",
        "doctrine/doctrine-bundle":                     "^1.6|^2.0",

        "sonata-project/user-bundle":                   "^5.0",
        "sonata-project/doctrine-orm-admin-bundle":     "*"
    },

    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "cache:clear --env=test": "symfony-cmd",
            "assets:install --relative": "symfony-cmd",
            "doctrine:schema:update --force --complete --no-interaction --no-debug": "symfony-cmd",
            "find var/cache/dev/*.xml | while read -r i; do cp -f \"$i\" var/cache/dev/testContainer.xml; done": "script",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },

    "config": {
        "preferred-install":                "dist",
        "allow-plugins": {
            "phpro/grumphp": true,
            "symfony/runtime": true,
            "phpro/grumphp-shim": true,
            "symfony/flex": true
        }
    },

    "archive": {
        "exclude": ["/app", "/bin", "/docs", "/tests", "/src/Entity"]
    }

}
